{
  "name": "@t2tx/iris",
  "version": "0.3.1",
  "description": "Slack ⇄ Claude Code bridge (minimal, self-hosted). Socket Mode + Bolt.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "iris": "dist/cli.js"
  },
  "files": [
    "dist",
    "iris.config.example.toml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:sea": "sh scripts/build-sea.sh",
    "build:sea:signed": "sh scripts/build-sea-signed.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "lint:complexity": "sh scripts/check-complexity.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm check && pnpm lint:complexity && pnpm test",
    "prepublishOnly": "pnpm verify && pnpm build",
    "prepare": "command -v lefthook >/dev/null 2>&1 && lefthook install || true",
    "smoke:pi": "tsx scripts/smoke-pi.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.2.0",
    "smol-toml": "^1.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^3.2.0",
    "esbuild": "^0.28.1",
    "lefthook": "^2.1.9",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  },
  "keywords": [
    "slack",
    "claude",
    "claude-code",
    "bridge",
    "socket-mode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t2tx/iris.git"
  },
  "homepage": "https://github.com/t2tx/iris#readme",
  "bugs": {
    "url": "https://github.com/t2tx/iris/issues"
  }
}
